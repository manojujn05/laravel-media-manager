{
    "name": "innopanda/laravel-asset-manager",
    "description": "Professional reusable asset manager for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Innopanda\\AssetManager\\": "src/",
            "Innopanda\\AssetManager\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/AssetFunctions.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innopanda\\AssetManager\\AssetManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}