{
    "name": "innopanda/laravel-asset-manager",
    "description": "Professional reusable asset manager for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Manoj Agrawal",
            "email": "manoj@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.8",
        "spatie/laravel-medialibrary": "^11.23"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "filament/filament": "^4.12",
        "filament/forms": "^4.12",
        "filament/support": "^4.12"
    },
    "autoload": {
        "psr-4": {
            "Innopanda\\AssetManager\\": "src/",
            "Innopanda\\AssetManager\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/AssetFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Innopanda\\AssetManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innopanda\\AssetManager\\AssetManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
