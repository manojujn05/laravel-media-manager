{
    "name": "innopanda/laravel-asset-manager",
    "description": "Professional reusable asset manager for Laravel built on Livewire and Spatie Media Library.",
    "type": "library",
    "keywords": [
        "laravel",
        "asset manager",
        "media browser",
        "livewire",
        "filament",
        "spatie medialibrary"
    ],
    "homepage": "https://innopanda.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Manoj Agrawal",
            "email": "manojujn@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/issues",
        "source": "https://github.com"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.8|^4.1",
        "spatie/laravel-medialibrary": "^11.23"
    },
    "require-dev": {
        "filament/filament": "^4.12",
        "filament/forms": "^4.12",
        "filament/support": "^4.12",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Innopanda\\AssetManager\\": "src/",
            "Innopanda\\AssetManager\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/AssetFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Innopanda\\AssetManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innopanda\\AssetManager\\AssetManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
